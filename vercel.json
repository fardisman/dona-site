{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }, { "key": "Content-Type", "value": "application/octet-stream" }] }
  ]
}
